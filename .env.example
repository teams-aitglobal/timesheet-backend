# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://timesheet:timesheet@localhost:5432/timesheet
DATABASE_URL_TEST=postgresql+asyncpg://timesheet:timesheet@localhost:5432/timesheet_test

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
